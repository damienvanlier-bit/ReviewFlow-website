# Kopieer dit bestand naar ".env" als je LOKAAL (op je eigen computer) wilt testen.
# Vul je eigen ".env" nooit in git in — dat bestand wordt bewust genegeerd (zie .gitignore).
# Voor het echte gebruik via GitHub hoef je dit bestand niet te gebruiken: daar vul je
# dezelfde waarden in als "Secrets" in de repository-instellingen. Zie automation/README.md.

ANTHROPIC_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
APPROVER_EMAIL=

# Deze vier worden normaal automatisch ingevuld via het GitHub-formulier,
# maar zijn ook nodig als je lokaal wilt testen:
CLIENT=ami-kappers-middelharnis
REVIEWER_NAME=Voorbeeldnaam
STARS=5
REVIEW_TEXT=Dit is een voorbeeldreview om het systeem te testen.
